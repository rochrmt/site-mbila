# Email(s) du/des administrateur(s) — accès au dashboard /admin.
# Liste séparée par des virgules. L'admin doit avoir un compte créé avec cet email.
ADMIN_EMAILS=toi@mbila.ca

# SMTP Gmail — OBLIGATOIRE en prod : emails de vérification de compte + alertes admin.
# SMTP_PASS = mot de passe d'application Google (Compte Google → Sécurité → Mots de passe des applications).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
MAIL_FROM="Mbila <votre-adresse@gmail.com>"
MAIL_TO=votre-adresse@gmail.com

# ── Paiement en ligne Chariow (optionnel — sans ça, seul Orange Money manuel reste) ──
# Clé API : tableau de bord Chariow → Développeurs → API keys (sk_live_…)
CHARIOW_API_KEY=
# Secret du Pulse : Automation → Pulses → créer un pulse vers
# https://mbila.ca/api/pulse (événements : successful.sale + failed.sale + abandoned.sale)
# → copier le "signature secret" affiché à la création.
CHARIOW_PULSE_SECRET=
# Produits par offre : clé "<plan>:<mois>[:<prixMensuel>]" → id du produit Chariow.
# "price" ne sert que pour l'affichage du bouton : le montant réellement débité et
# enregistré est récupéré en direct via l'API Chariow au moment du paiement —
# changer un prix dans Chariow suffit (le .env ne sert qu'au libellé).
CHARIOW_PRODUCTS={"essentiel:1:3000":{"id":"prd_6hr8fhj2","price":3000},"essentiel:6:3000":{"id":"prd_sw44w33o","price":16200},"essentiel:12:3000":{"id":"prd_ybsgitj3","price":30000},"essentiel:1:5500":{"id":"prd_oo7lw28i","price":5500},"essentiel:6:5500":{"id":"prd_agn57pdi","price":29700},"essentiel:12:5500":{"id":"prd_31sja1a7","price":55000},"essentiel:1:7500":{"id":"prd_ni2xkyux","price":7500},"essentiel:6:7500":{"id":"prd_alv2oin5","price":40500},"essentiel:12:7500":{"id":"prd_5r9sgfvz","price":75000},"essentiel:1:8500":{"id":"prd_dke0fzm7","price":8500},"essentiel:6:8500":{"id":"prd_r6tu86p6","price":45900},"essentiel:12:8500":{"id":"prd_fhcbq3zi","price":85000},"premium:1":{"id":"prd_e7bb83xe","price":11500},"premium:6":{"id":"prd_k2d1lzix","price":62100},"premium:12":{"id":"prd_q7czu3dn","price":115000}}

# NB : HOSTINGER_API_TOKEN va dans la config de Traefik (/opt/traefik/ sur le VPS), pas ici.
# ROOT_DOMAIN est défini dans docker-compose.yml.
